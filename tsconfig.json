{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Vitest's source/script tests belong to tsconfig.test.json for every
    // supported extension. Keep e2e/*.spec.ts in this project until #2693
    // gives Playwright a deliberate project of its own.
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "scripts/**/*.test.*",
    "scripts/**/*.spec.*",
    "**/__tests__/**",
    // #2686: Semgrep rule fixtures. They are deliberately-broken sample code
    // whose only reader is Semgrep's own `--test` runner — they import modules
    // that do not resolve from that directory and they exist to be reported.
    // Type-checking them would fail, and fixing them to type-check would stop
    // them being fixtures.
    ".semgrep/**"
  ]
}
